---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { businesses } from "../../data/company";
---

<BaseLayout
  title="사업영역"
  description="대원기술의 전기공사, 기계가스설비공사, 구조물해체·비계공사, 전문소방시설공사 사업영역과 수행 범위를 확인하세요."
>
  <PageIntro
    title="사업영역"
    eyebrow="OUR BUSINESS"
    description="4개 공사업의 전문성을 연결해 발전·산업 플랜트의 시공과 정비를 수행합니다."
  />
  <div class="container page-content">
    <div class="service-grid">
      {
        businesses.map((b) => (
          <article class="service-box">
            <>
              <span class="eyebrow">
                {b.number} / {b.english}
              </span>
              <h2>{b.title}</h2>
              <p>{b.summary}</p>
              <a class="text-link" href={`/business/${b.slug}/`}>
                수행 범위 자세히 보기 <span aria-hidden="true">→</span>
              </a>
            </>
          </article>
        ))
      }
    </div><section class="stack-section prose">
      <h2>공종 사이의 연결까지 관리합니다.</h2><p>
        착공 전 현장 조건과 공종 간 간섭을 검토하고, 시공 과정의 변경과 품질기록을 공유합니다.
        설치·정비 이후에는 시험·검사·정리·인계까지 일관되게 마무리합니다.
      </p>
    </section>
  </div>
</BaseLayout>
