---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { company } from "../../data/company";
const mapQuery = encodeURIComponent(company.address);
---

<BaseLayout
  title="문의·오시는 길"
  description="주식회사 대원기술 사업·제휴 문의: 054-783-9170, dwtec@dw-tec.co.kr. 경상북도 울진군 북면 남산길 64, 2층."
>
  <PageIntro
    title="문의·오시는 길"
    eyebrow="CONTACT DW-TEC"
    description="공사 수행, 협력업체 등록, 사업 제휴에 관한 문의를 기다립니다."
  />
  <div class="container page-content">
    <div class="info-grid">
      <section class="contact-card" data-reveal="up">
        <h2>사업·제휴 문의</h2><a href={`tel:${company.phone}`}>{company.phone}</a><a
          href={`mailto:${company.email}`}>{company.email}</a
        ><p>팩스 {company.fax}</p><p>
          전화나 이메일로 문의하시면 업무 내용에 맞춰 안내해 드립니다. 이메일에는 성명·회신 연락처와
          문의 내용을 적어주세요. 주민등록번호·계좌정보 등 민감정보는 보내지 마세요.
        </p>
      </section><section class="contact-card" data-reveal="up">
        <h2>오시는 길</h2><p>{company.address}</p><a
          class="button button-dark"
          href={`https://map.naver.com/p/search/${mapQuery}`}
          target="_blank"
          rel="noopener noreferrer"
          >네이버지도에서 보기 <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span
          ></a
        ><p class="note">외부 지도 서비스로 이동합니다. 방문 전 대표전화로 일정을 확인해 주세요.</p>
      </section>
    </div>
  </div>
</BaseLayout>
