---
import { businesses, company } from "../data/company";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <a class="footer-brand" href="/">{company.name}</a><p>{company.englishName}</p><p>
        발전·산업 플랜트 전문 시공
      </p>
    </div>
    <nav class="footer-links" aria-label="하단 회사 메뉴">
      <strong>COMPANY</strong><a href="/company/">회사소개</a><a href="/company/history/"
        >회사 연혁</a
      ><a href="/company/capabilities/">기술·인증</a><a href="/portfolio/">수행실적</a><a
        href="/contact/">문의·오시는 길</a
      >
    </nav>
    <nav class="footer-links" aria-label="하단 사업 메뉴">
      <strong>BUSINESS</strong>{
        businesses.map((b) => <a href={`/business/${b.slug}/`}>{b.title}</a>)
      }
    </nav>
    <div class="footer-details">
      <strong>CONTACT</strong><a class="footer-contact" href={`tel:${company.phone}`}
        >{company.phone}</a
      ><a href={`mailto:${company.email}`}>{company.email}</a><p>팩스 {company.fax}</p><p>
        {company.address}
      </p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>
      대표이사 {company.representative}<br />© {new Date().getFullYear()} DW-TEC. All rights reserved.
    </p><a href="/privacy/">개인정보 안내</a><a class="back-top" href="#page-top"
      >맨 위로 <span aria-hidden="true">↑</span></a
    >
  </div>
</footer>
