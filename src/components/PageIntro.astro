---
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  locale?: "ko" | "en";
  breadcrumbHomeLabel?: string;
  breadcrumbHomeHref?: string;
}
const {
  title,
  eyebrow,
  description,
  locale = "ko",
  breadcrumbHomeLabel,
  breadcrumbHomeHref = locale === "ko" ? "/" : "/en/",
} = Astro.props;
---

<section
  class:list={[
    "page-hero",
    {
      "no-motion":
        locale === "ko"
          ? Astro.url.pathname.startsWith("/privacy")
          : Astro.url.pathname.startsWith("/en/privacy"),
    },
  ]}
>
  <div class="container">
    <nav class="breadcrumb" aria-label={locale === "ko" ? "현재 위치" : "Breadcrumb"}>
      <a href={breadcrumbHomeHref}>{breadcrumbHomeLabel ?? (locale === "ko" ? "홈" : "Home")}</a>
      <span aria-hidden="true">/</span><span aria-current="page">{title}</span>
    </nav><p class="eyebrow">
      {eyebrow}
    </p><h1>{title}</h1><p class="lead">{description}</p>
  </div>
</section>
