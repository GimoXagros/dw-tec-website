---
import TechnicalMark from "./TechnicalMark.astro";
interface Props {
  title: string;
  eyebrow: string;
  description: string;
}
const { title, eyebrow, description } = Astro.props;
const quiet = Astro.url.pathname.startsWith("/privacy");
const kind = Astro.url.pathname.split("/").filter(Boolean).at(-1);
---

<section class:list={["page-hero", { "no-motion": quiet }]}>
  <div class="container">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href="/">홈</a>
      <span aria-hidden="true">/</span><span aria-current="page">{title}</span>
    </nav><p class="eyebrow">
      {eyebrow}
    </p><h1>{title}</h1><p class="lead">{description}</p>
    {!quiet && <TechnicalMark kind={kind} />}
  </div>
</section>
