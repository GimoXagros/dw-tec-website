---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../PageIntro.astro";
import { businesses } from "../../data/company";
import { businessDetailPath, pathForKey } from "../../i18n/routes";
import type { Locale } from "../../i18n/types";
interface Props {
  locale: Locale;
  business: (typeof businesses)[number];
}
const { locale, business } = Astro.props;
const ko = locale === "ko";
const title = ko ? business.titleKo : business.titleEn;
const summary = ko ? business.summaryKo : business.summaryEn;
const manufacturing = business.slug === "manufacturing";
const evidence = ko ? business.evidenceKo : business.evidenceEn;
---

<BaseLayout
  locale={locale}
  title={title}
  description={`${summary} ${ko ? business.descriptionKo : business.descriptionEn}`}
  socialImage={false}
>
  <PageIntro locale={locale} title={title} eyebrow={business.shortEn} description={summary} />
  <div class="container page-content">
    <nav class="section-subnav" aria-label={ko ? "사업 분야" : "Business disciplines"}>
      {
        businesses.map((b) => (
          <a
            href={businessDetailPath(locale, b.slug)}
            aria-current={b.slug === business.slug ? "page" : undefined}
          >
            {ko ? b.titleKo : b.titleEn}
          </a>
        ))
      }
    </nav><div class="detail-grid">
      <div>
        <div class="prose" data-reveal="up">
          <h2>
            {
              manufacturing
                ? ko
                  ? "등록 공장에서 시작하는 제조"
                  : "Manufacturing from a registered factory"
                : ko
                  ? "현장을 위한 전문 시공"
                  : "Specialized field execution"
            }
          </h2><p>
            {ko ? business.descriptionKo : business.descriptionEn}
          </p>
        </div><section class="stack-section" data-reveal="up">
          <h2>{ko ? "주요 수행 범위" : "Primary scope"}</h2><ul class="clean-list">
            {(ko ? business.servicesKo : business.servicesEn).map((s) => <li>{s}</li>)}
          </ul>
        </section>
      </div><aside class="aside-panel">
        <h2>
          {
            manufacturing
              ? ko
                ? "공장등록 및 시설"
                : "Factory registration & facilities"
              : ko
                ? "작업의 기준"
                : "Execution controls"
          }
        </h2><ul class="clean-list">
          {(ko ? business.checksKo : business.checksEn).map((c) => <li>{c}</li>)}
        </ul><p class="note">
          {
            ko
              ? "구체적인 작업 범위와 투입 계획은 현장 요구조건 및 계약 범위에 따라 협의합니다."
              : "Detailed work scope and mobilization plans are agreed based on field requirements and contract scope."
          }
        </p><a class="button button-dark" href={pathForKey("contact", locale)}
          >{ko ? "프로젝트 문의" : "Project inquiry"} <span aria-hidden="true">↗</span></a
        >
      </aside>
    </div>{
      evidence.length > 0 && (
        <section class="stack-section evidence-capability-section" data-reveal="up">
          <p class="eyebrow">CONTRACT-BASED CAPABILITY</p>
          <h2>
            {ko
              ? "계약 실적이 증명하는 제조·납품 역량"
              : "Manufacturing and supply proven by contract experience"}
          </h2>
          <p class="evidence-intro">
            {ko
              ? "제출된 발주기관 물품구매 계약 자료에서 반복적으로 확인된 제작·조달·검사·인도 조건을 수행역량 중심으로 정리했습니다. 민감한 계약 세부정보는 공개하지 않습니다."
              : "These capabilities summarize recurring fabrication, procurement, inspection, and delivery requirements evidenced by submitted public-client purchase contracts. Sensitive contract details are not disclosed."}
          </p>
          <div class="evidence-capability-grid">
            {evidence.map((item, index) => (
              <article>
                <span>0{index + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }<section class="stack-section">
      <h2>{ko ? "함께 연결되는 사업" : "Related disciplines"}</h2><div class="related-business">
        {
          businesses
            .filter((b) => b.slug !== business.slug)
            .map((b) => (
              <a href={businessDetailPath(locale, b.slug)}>
                {ko ? b.titleKo : b.titleEn} <span aria-hidden="true">↗</span>
              </a>
            ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
