---
import TechnicalMark from "../TechnicalMark.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../PageIntro.astro";
import { businesses } from "../../data/company";
import { businessDetailPath } from "../../i18n/routes";
import type { Locale } from "../../i18n/types";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ko = locale === "ko";
---

<BaseLayout
  locale={locale}
  title={ko ? "사업영역" : "Business"}
  description={ko
    ? "대원기술의 전기공사, 기계가스설비공사, 구조물해체·비계공사, 전문소방시설공사 사업영역을 소개합니다."
    : "Electrical, mechanical and gas facilities, structural demolition and scaffolding, and specialized fire protection construction by DAEWON TECHNOLOGY."}
>
  <PageIntro
    locale={locale}
    title={ko ? "사업영역" : "Business"}
    eyebrow="OUR BUSINESS"
    description={ko
      ? "4개 공사업의 전문성을 연결해 발전·산업 플랜트의 시공과 정비를 수행합니다."
      : "Four registered disciplines connected for power and industrial plant construction and maintenance."}
  />
  <div class="container page-content">
    <div class="service-grid">
      {
        businesses.map((b) => (
          <article class="service-box" data-reveal="up">
            <>
              <span class="eyebrow">
                {b.number} / {b.shortEn}
              </span>
              <TechnicalMark kind={b.slug} />
              <h2>{ko ? b.titleKo : b.titleEn}</h2>
              <p>{ko ? b.summaryKo : b.summaryEn}</p>
              <ul class="clean-list">
                {(ko ? b.servicesKo : b.servicesEn).map((service) => (
                  <li>{service}</li>
                ))}
              </ul>
              <a class="text-link" href={businessDetailPath(locale, b.slug)}>
                {ko ? "수행 범위 자세히 보기" : "View detailed scope"}{" "}
                <span aria-hidden="true">→</span>
              </a>
            </>
          </article>
        ))
      }
    </div><section class="stack-section prose">
      <h2>
        {ko ? "공종 사이의 연결까지 관리합니다." : "We manage the interfaces between disciplines."}
      </h2><p>
        {
          ko
            ? "착공 전 현장 조건과 공종 간 간섭을 검토하고, 시공 과정의 변경과 품질기록을 공유합니다. 설치·정비 이후에는 시험·검사·정리·인계까지 일관되게 마무리합니다."
            : "Before mobilization, we review field conditions and trade interfaces. During execution, changes and quality records are controlled, followed by testing, inspection, closeout, and handover."
        }
      </p>
    </section>
  </div>
</BaseLayout>
