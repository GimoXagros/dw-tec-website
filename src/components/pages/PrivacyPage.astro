---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../PageIntro.astro";
import { company } from "../../data/company";
import type { Locale } from "../../i18n/types";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ko = locale === "ko";
---

<BaseLayout
  locale={locale}
  title={ko ? "개인정보 안내" : "Privacy Notice"}
  description={ko
    ? "대원기술 홈페이지의 정적 호스팅, 외부 링크, 전화·이메일 문의와 개인정보 처리 관련 안내입니다."
    : "Privacy information about static hosting, external links, and phone and email inquiries on the DAEWON TECHNOLOGY website."}
>
  <PageIntro
    locale={locale}
    title={ko ? "개인정보 안내" : "Privacy Notice"}
    eyebrow="PRIVACY INFORMATION"
    description={ko
      ? "이 홈페이지에서 사용하는 기능과 데이터 흐름을 안내합니다."
      : "How this website works and where data may flow."}
  />
  <div class="container page-content">
    <article class="prose">
      <h2>{ko ? "웹사이트 방문" : "Website visits"}</h2><p>
        {
          ko
            ? "이 사이트는 회사 정보를 제공하는 정적 홈페이지입니다. 회원가입, 문의 입력 폼, 결제, 광고 및 방문자 분석 도구를 사용하지 않습니다. 사이트 자체에서 방문자 추적용 쿠키나 브라우저 저장소를 사용하지 않습니다."
            : "This is a static corporate information website. It does not use registration, inquiry forms, payments, advertising, visitor analytics, tracking cookies, or browser storage."
        }
      </p><h2>{ko ? "호스팅 서비스" : "Hosting service"}</h2><p>
        {
          ko
            ? "웹사이트는 GitHub Pages를 통해 제공하도록 구성되어 있습니다. 서비스 제공자는 보안 및 운영을 위해 접속 정보 등을 처리할 수 있습니다."
            : "The website is configured for GitHub Pages. The service provider may process access information for security and operations."
        }
        <a
          class="text-link"
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
          target="_blank"
          rel="noopener noreferrer"
          >{ko ? "GitHub 개인정보 안내" : "GitHub Privacy Statement"}
          <span class="sr-only">{ko ? "(새 창)" : "(opens in a new tab)"}</span></a
        >
      </p><h2>{ko ? "전화·이메일 문의" : "Phone and email inquiries"}</h2><p>
        {
          ko
            ? "전화 링크는 기기의 전화 기능을, 이메일 링크는 사용자가 설정한 이메일 프로그램을 엽니다. 홈페이지가 입력 내용을 받아 저장하거나 자동 전송하지 않습니다."
            : "Phone links open your device's call function and email links open your configured email client. The website does not receive, store, or automatically transmit inquiry content."
        }
      </p><h2>{ko ? "외부 지도 서비스" : "External map service"}</h2><p>
        {
          ko
            ? "지도 링크를 선택하면 네이버지도 등 외부 서비스로 이동하며, 이동한 서비스의 개인정보 안내가 적용됩니다."
            : "Selecting the map link opens an external service, whose privacy terms apply."
        }
      </p><h2>{ko ? "문의처" : "Contact"}</h2><p>
        {ko ? company.name : company.englishName}<br /><a href={`tel:${company.phone}`}
          >{company.phone}</a
        ><br /><a href={`mailto:${company.email}`}>{company.email}</a>
      </p><p class="note">
        {ko ? "안내 작성일: 2026년 9월 2일." : "Notice date: September 2, 2026."}
      </p>
    </article>
  </div>
</BaseLayout>
