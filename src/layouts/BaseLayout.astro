---
import "../styles/global.css";
import "../styles/corporate.css";
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { company } from "../data/company";
import type { Locale } from "../i18n/messages";
import { getMessages } from "../i18n/messages";
import { toLocalePath } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  noindex?: boolean;
  socialImage?: boolean;
}

const { title, description, locale = "ko", noindex = false, socialImage = true } = Astro.props;
const t = getMessages(locale);
const isNotFound = Astro.url.pathname.startsWith("/404");
const canonicalPath = isNotFound ? "/404.html" : toLocalePath(Astro.url.pathname, locale) || "/";
const canonical = new URL(canonicalPath, company.url).href;
const ogAlt =
  locale === "ko"
    ? "주식회사 대원기술 — 발전·산업 플랜트 전문 시공"
    : "DAEWON TECHNOLOGY — Power and industrial plant construction partner";

const alternateKo = toLocalePath(Astro.url.pathname, "ko");
const alternateEn = toLocalePath(Astro.url.pathname, "en");

const structured = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: locale === "ko" ? company.name : company.englishName,
  alternateName: company.brand,
  url: company.url,
  logo: `${company.url}/images/logo.png`,
  telephone: company.phone,
  faxNumber: company.fax,
  email: company.email,
  foundingDate: company.founded,
  address: {
    "@type": "PostalAddress",
    streetAddress: "북면 남산길 64, 2층",
    addressLocality: "울진군",
    addressRegion: "경상북도",
    addressCountry: "KR",
  },
};
---

<!doctype html>
<html lang={locale === "ko" ? "ko" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      ["/", "/en/"].includes(Astro.url.pathname) && (
        <link
          rel="preload"
          as="image"
          href="/images/plant-concept-1600.avif"
          imagesrcset="/images/plant-concept-800.avif 800w, /images/plant-concept-1600.avif 1600w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <title>{title} | {locale === "ko" ? "대원기술" : "DAEWON TECHNOLOGY"}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {
      !isNotFound && (
        <>
          <link rel="alternate" hreflang="ko" href={`${company.url}${alternateKo}`} />
          <link rel="alternate" hreflang="en" href={`${company.url}${alternateEn}`} />
          <link rel="alternate" hreflang="x-default" href={`${company.url}${alternateKo}`} />
        </>
      )
    }
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#102e55" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "ko" ? "ko_KR" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "ko" ? "en_US" : "ko_KR"} />
    <meta property="og:site_name" content={locale === "ko" ? company.name : company.englishName} />
    <meta
      property="og:title"
      content={`${title} | ${locale === "ko" ? "대원기술" : "DAEWON TECHNOLOGY"}`}
    />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      socialImage && (
        <>
          <meta property="og:image" content={`${company.url}/og/company.png`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={ogAlt} />
        </>
      )
    }
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta
      name="twitter:title"
      content={`${title} | ${locale === "ko" ? "대원기술" : "DAEWON TECHNOLOGY"}`}
    />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={`${company.url}/og/company.png`} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}
    />
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main">
      {t.skipLink}
    </a>
    <SiteHeader locale={locale} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} />
    <script>
      import { initMotion } from "../scripts/motion";
      import { initNavigation } from "../scripts/navigation";
      initNavigation();
      initMotion();
      document.addEventListener("astro:page-load", () => {
        initNavigation();
        initMotion();
      });
    </script>
  </body>
</html>
