---
import "../styles/global.css";
import "../styles/corporate.css";
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { company } from "../data/company";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  socialImage?: boolean;
}
const { title, description, noindex = false, socialImage = true } = Astro.props;
const canonical = new URL(
  Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname,
  company.url,
).href;
const structured = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: company.name,
  alternateName: company.brand,
  url: company.url,
  logo: `${company.url}/images/logo.png`,
  telephone: company.phone,
  faxNumber: company.fax,
  email: company.email,
  foundingDate: company.founded,
  address: {
    "@type": "PostalAddress",
    streetAddress: "북면 남산길 64, 2층",
    addressLocality: "울진군",
    addressRegion: "경상북도",
    addressCountry: "KR",
  },
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      Astro.url.pathname === "/" && (
        <link
          rel="preload"
          as="image"
          href="/images/corporate-hero-1600.avif"
          imagesrcset="/images/corporate-hero-800.avif 800w, /images/corporate-hero-1600.avif 1600w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <title>{title} | 대원기술</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#102e55" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={`${title} | 대원기술`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      socialImage && (
        <>
          <meta property="og:image" content={`${company.url}/og/company.png`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="주식회사 대원기술 — 발전·산업 플랜트 전문 시공" />
        </>
      )
    }
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} | 대원기술`} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={`${company.url}/og/company.png`} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}
    />
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>
      import { initMotion } from "../scripts/motion";
      import { initNavigation } from "../scripts/navigation";
      initNavigation();
      initMotion();
      document.addEventListener("astro:page-load", () => {
        initNavigation();
        initMotion();
      });
    </script>
  </body>
</html>
