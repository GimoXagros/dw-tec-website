---
import "../styles/global.css";
import "../styles/corporate.css";
import { company } from "../data/company";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  socialImage?: boolean;
}
const { title, description, noindex = false, socialImage = true } = Astro.props;
const canonical = new URL(
  Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname,
  company.url,
).href;
const nav = [
  { href: "/company/", label: "회사소개" },
  { href: "/business/", label: "사업영역" },
  { href: "/portfolio/", label: "수행실적" },
  { href: "/company/capabilities/", label: "기술·인증" },
  { href: "/contact/", label: "문의·오시는 길" },
];
const structured = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: company.name,
  alternateName: company.brand,
  url: company.url,
  logo: `${company.url}/images/logo.png`,
  telephone: company.phone,
  faxNumber: company.fax,
  email: company.email,
  foundingDate: company.founded,
  address: {
    "@type": "PostalAddress",
    streetAddress: "북면 남산길 64, 2층",
    addressLocality: "울진군",
    addressRegion: "경상북도",
    addressCountry: "KR",
  },
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      Astro.url.pathname === "/" && (
        <link
          rel="preload"
          as="image"
          href="/images/corporate-hero-1600.avif"
          imagesrcset="/images/corporate-hero-800.avif 800w, /images/corporate-hero-1600.avif 1600w"
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    <title>{title} | 대원기술</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#102e55" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={`${title} | 대원기술`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      socialImage && (
        <>
          <meta property="og:image" content={`${company.url}/og/company.png`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="주식회사 대원기술 — 발전·산업 플랜트 전문 시공" />
        </>
      )
    }
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} | 대원기술`} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={`${company.url}/og/company.png`} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="대원기술 홈"
        ><img src="/images/logo.png" width="247" height="56" alt="주식회사 대원기술" /></a
      >
      <button
        class="menu-button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="메뉴 열기"><span></span><span></span><span></span></button
      >
      <nav id="site-nav" aria-label="주 메뉴">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div><p class="footer-brand">{company.name}</p><p>{company.englishName}</p></div><a
          class="footer-contact"
          href={`tel:${company.phone}`}>{company.phone}<span>사업 및 제휴 문의</span></a
        >
      </div>
      <div class="container footer-bottom">
        <div>
          <p>대표이사 {company.representative} · {company.address}</p><a
            href={`mailto:${company.email}`}>{company.email}</a
          >
          <p>팩스 {company.fax}</p>
        </div><div>
          <a href="/privacy/">개인정보 안내</a><p>
            © {new Date().getFullYear()} DW-TEC. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".menu-button");
      const nav = document.querySelector<HTMLElement>("#site-nav");
      function setMenu(open: boolean) {
        button?.setAttribute("aria-expanded", String(open));
        button?.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
        nav?.classList.toggle("is-open", open);
      }
      button?.addEventListener("click", () =>
        setMenu(button.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
          setMenu(false);
          button.focus();
        }
      });
      nav
        ?.querySelectorAll("a")
        .forEach((link) => link.addEventListener("click", () => setMenu(false)));
      document.addEventListener("click", (event) => {
        if (
          event.target instanceof Node &&
          !nav?.contains(event.target) &&
          !button?.contains(event.target)
        )
          setMenu(false);
      });
    </script>
  </body>
</html>
