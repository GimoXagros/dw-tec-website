  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:links": "node scripts/check-output.mjs",
    "test:smoke": "playwright test",
    "test:privacy": "node scripts/check-public-safety.mjs",
    "test:history": "node scripts/check-history.mjs",
    "validate": "npm run format:check && npm run lint && npm run check && npm run build && npm run test:links && npm run test:privacy && npm run test:smoke"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "lighthouse": "13.6.0",
    "pretendard": "1.3.9",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
