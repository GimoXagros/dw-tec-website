    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-astro": "3.2.1",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "pretendard": "1.3.9"
